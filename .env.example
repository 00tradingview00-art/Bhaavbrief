# ─── Anthropic (Claude API) ───────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Brevo (Email) ────────────────────────────────────────────────────────────
# Get from: Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-...
# Your Brevo contact list ID (find in Contacts → Lists)
BREVO_LIST_ID=2
# Your verified sender email in Brevo
SENDER_EMAIL=brief@bhaavbrief.in

# ─── Kite Connect (MCX live prices/options) ───────────────────────────────────
# Get from: https://developers.kite.trade
KITE_API_KEY=...
KITE_API_SECRET=...
# Short-lived — refreshed daily via /api/kite/callback or scripts/kite-morning-auth.js
KITE_ACCESS_TOKEN=...
# Optional — Zerodha login automation for the morning auth script
ZERODHA_USER_ID=...
ZERODHA_PASSWORD=...
ZERODHA_TOTP_SECRET=...

# ─── Cron / ops auth ───────────────────────────────────────────────────────────
# Shared secret for Vercel Cron + manual triggers on /api/cron/* and /api/kite/discover.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>` for scheduled crons.
CRON_SECRET=...

# ─── Internal Pro access (backend/testing only — never exposed to real users) ──
# Grants full Pro-tier data to server-to-server callers that send
# `Authorization: Bearer <INTERNAL_ACCESS_SECRET>` on Pro-gated /api/options/*
# routes (see lib/subscription.ts's hasInternalAccess()) — for the site's own
# content-generation scripts (e.g. scripts/generate-campaign-reel.mjs), not for
# any customer-facing flow. Deliberately a different secret from CRON_SECRET —
# a different privilege, kept separate so a leak of one doesn't grant the other.
INTERNAL_ACCESS_SECRET=...

# ─── Staging (dev.bhaavbrief.in only — leave unset on Production) ─────────────
# Set to "true" only on the staging deployment/branch. Blocks the whole site
# from search indexing (next.config.mjs adds X-Robots-Tag: noindex, and
# app/robots.ts returns a blanket disallow) and is what makes dev.bhaavbrief.in
# a safe place to run real Cashfree sandbox test purchases without it ever
# showing up in search results. Everything else on staging (Redis, Clerk, Kite)
# intentionally shares production's values — only CASHFREE_ENV/CASHFREE_CLIENT_ID/
# CASHFREE_CLIENT_SECRET should differ there (sandbox/test credentials).
IS_STAGING=...

# ─── GitHub (workflow dispatch + secrets sync) ────────────────────────────────
# Fine-grained PAT with `actions:write` + `secrets:write` on this repo.
GH_PAT=github_pat_...
# Some routes read GITHUB_PAT as an alias of the same token — keep both set to the same value.
GITHUB_PAT=github_pat_...
GITHUB_REPO=00tradingview00-art/Bhaavbrief
GITHUB_REPO_ID=...

# ─── Vercel (env var + deploy automation) ─────────────────────────────────────
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=...
VERCEL_PROJECT_ID=...
VERCEL_DEPLOY_HOOK=...

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Get from: Upstash console → REST API. Optional — rate limiters fail open if unset.
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Instagram / Meta Graph API (auto-posting) ────────────────────────────────
INSTAGRAM_USER_ID=...
INSTAGRAM_ACCESS_TOKEN=...
META_APP_ID=...
META_APP_SECRET=...

# ─── Market/news data providers ────────────────────────────────────────────────
EIA_API_KEY=...
TWELVE_DATA_API_KEY=...
ALPHA_VANTAGE_KEY=...
PEXELS_API_KEY=...

# ─── ElevenLabs (brief reel voiceover) ─────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ─── PostHog (analytics) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Clerk (authentication) ────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/options
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/options

# ─── Cashfree (subscriptions — primary billing) ───────────────────────────────
# Dashboard: https://merchant.cashfree.com → Developers → API Keys
# Use sandbox keys with CASHFREE_ENV=sandbox; production keys with production.
CASHFREE_CLIENT_ID=...
# Also used to verify webhook signatures — Cashfree has no separate webhook
# secret, just a URL you register (PG → Developers → Webhooks → Subscriptions).
CASHFREE_CLIENT_SECRET=...
CASHFREE_ENV=sandbox
# Plan IDs created in Cashfree Subscriptions (PERIODIC)
CASHFREE_PLAN_ID_DAILY=Prabal_33
CASHFREE_PLAN_ID_MONTHLY=Prabal_333
CASHFREE_PLAN_ID_YEARLY=Prabal_2999
# Public site URL used for Cashfree return_url
NEXT_PUBLIC_SITE_URL=https://bhaavbrief.in
