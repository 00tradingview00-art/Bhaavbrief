.env
.env.local
.env.*.local
node_modules/
.next/
out/
.DS_Store
*.log
.vercel
scripts/.kite-session.json
tsconfig.tsbuildinfo
.claude/scheduled_tasks.lock

# Transient, single-CI-run-scoped: passes data from validate-brief.mjs to
# apply-human-gate.mjs (G-12) within the same job. data/gate-streak.json is
# NOT here — that one is persistent state and must be committed.
data/last-gate-result.json

# C-02: quarantined snapshot payloads that failed schema/plausibility
# validation — debug artifacts, not canonical data. Job logs already
# capture the specific violations; these just aren't meant to be committed.
data/quarantine/

# scripts/dev-preview-chart.mjs's throwaway output — regenerate on demand,
# never meant to be committed.
.dev-chart-preview.png

# scripts/generate-brief-reel.mjs writes this to hand its resolved output
# path back to a caller (scripts/generate-learn-reel.mjs) that shells out to
# it — normally consumed and deleted by that caller, but left behind as a
# stray untracked file if the script is ever run standalone/interrupted.
.reel-output-path.txt
